// Define a struct to hold game entities
typedef struct {
    int locations[MONSTER_SIZE_HARD]; // Assuming max monsters for hard level
    int size;
    //int surprise[SURPRISE_SIZE_HARD]; // Assuming max surprise for hard level
    int used_locations[MAX_INDEX];
} EntityLocations;

// Function to save the game state to a file
void save_game(int exit, EntityLocations monsters, EntityLocations hearts, EntityLocations surprise, int current_heart, int grid_size, int current_index, EntityLocations used_indices, int used_count, char grid_display[][MAX_GRID], int errormove) {
    FILE* file = fopen(SAVE_FILE, "wb");
    if (file) {
        fwrite(&grid_size, sizeof(int), 1, file);
        fwrite(&exit, sizeof(int), 1, file);
        fwrite(&monsters, sizeof(EntityLocations), 1, file);
        fwrite(&hearts, sizeof(EntityLocations), 1, file);
        fwrite(&surprise, sizeof(EntityLocations), 1, file);
        fwrite(&current_heart, sizeof(int), 1, file);
        fwrite(&current_index, sizeof(int), 1, file);
        fwrite(&used_count, sizeof(int), 1, file);
        //fwrite(&used_indices, sizeof(EntityLocations), used_count, file);
        fwrite(used_indices.used_locations, sizeof(int), used_count, file); // Save the array
        fwrite(grid_display, sizeof(char), grid_size * grid_size, file);
        fwrite(&errormove, sizeof(int), 1, file);
        fclose(file);
        printf("Game saved successfully!\n");
    }
    else {
        printf("Error saving game!\n");
    }
}

// Function to load the game state from a file
int load_game(int* exit, EntityLocations* monsters, EntityLocations* hearts, EntityLocations* surprise, int* current_heart, int* grid_size, int* current_index, EntityLocations* used_indices, int* used_count, char grid_display[][MAX_GRID], int* errormove) {
    FILE* file = fopen(SAVE_FILE, "rb");
    if (file) {
        fread(grid_size, sizeof(int), 1, file);
        fread(exit, sizeof(int), 1, file);
        fread(monsters, sizeof(EntityLocations), 1, file);
        fread(hearts, sizeof(EntityLocations), 1, file);
        fread(surprise, sizeof(EntityLocations), 1, file);
        fread(current_heart, sizeof(int), 1, file);
        fread(current_index, sizeof(int), 1, file);
        fread(used_count, sizeof(int), 1, file);
        //fread(used_indices, sizeof(EntityLocations), 1, file);
        fread(used_indices->used_locations, sizeof(int), *used_count, file); // Load the array
        fread(grid_display, sizeof(char), (*grid_size) * (*grid_size), file);
        fread(errormove, sizeof(int), 1, file);
        fclose(file);
        printf("Game loaded successfully!\n");
        return 1; // Return 1 if loaded successfully
    }
    else {
        printf("No saved game found!\n");
        return 0; // Return 0 if no saved game
    }
}

//the game itself
void game(int exit, EntityLocations monsters, EntityLocations hearts, int current_heart, int grid_size, int start_index, EntityLocations surprise, EntityLocations used_indices, int load_flag) {
    int result = 0;
    int input_check = 0;
    int grid[MAX_GRID][MAX_GRID];
    char grid_display[MAX_GRID][MAX_GRID];
    int current_index = start_index;
    int used_count = 1;
    int errormove = 0;

    HANDLE  color = GetStdHandle(STD_OUTPUT_HANDLE);

    // Initialize grid for a new game (in case of a new game or failed load)
    int num = 1;
    for (int i = 0; i < grid_size; i++) {
        for (int j = 0; j < grid_size; j++) {
            grid[i][j] = num++;
            grid_display[i][j] = ' ';
        }
    }
    int start_row = (start_index - 1) / grid_size;
    int start_col = (start_index - 1) % grid_size;
    grid_display[start_row][start_col] = 'o';


    // If game was loaded, update grid_display with previous moves
    // load_flag is determined in main and passed to game implicitly
    if (load_flag) {
        for (int i = 0; i < (grid_size * grid_size) - 1; i++) {
            int prev_row = (used_indices.used_locations[i] - 1) / grid_size;
            int prev_col = (used_indices.used_locations[i] - 1) % grid_size;
            if (prev_row >= 0 && prev_row < grid_size && prev_col >= 0 && prev_col < grid_size) {
                grid_display[prev_row][prev_col] = 'x';
            }
        }
        int current_row = (current_index - 1) / grid_size;
        int current_col = (current_index - 1) % grid_size;
        if (current_row >= 0 && current_row < grid_size && current_col >= 0 && current_col < grid_size) {
            grid_display[current_row][current_col] = 'o'; // Ensure current position is 'o'
        }
    }
    else {
        used_indices.used_locations[0] = start_index;
    }

    while (used_count < grid_size * grid_size) {
        // Print the grid
        printf(" +");
        for (int i = 0; i < grid_size; i++) {
            printf("---+");
        }
        printf("\n");
        for (int i = 0; i < grid_size; i++) {
            printf(" |");
            for (int j = 0; j < grid_size; j++) {
                if (grid_display[i][j] == 'o' || grid_display[i][j] == 'x') {
                    printf(" %c |", grid_display[i][j]);
                }
                else {
                    printf("%2d |", grid[i][j]);
                }
            }
            printf("\n +");
            for (int k = 0; k < grid_size; k++) {
                printf("---+");
            }
            printf("\n");
        }
        printf("\n\nyou have %d hearts\n", current_heart);

        // Check available moves
        int available_moves[4] = { 0 }; // left, right, up, down
        int move_count = 0;

        int current_row = (current_index - 1) / grid_size;
        int current_col = (current_index - 1) % grid_size;

        // Check left
        if (current_col > 0 && grid_display[current_row][current_col - 1] == ' ') {
            available_moves[move_count++] = current_index - 1;
        }
        // Check right
        if (current_col < grid_size - 1 && grid_display[current_row][current_col + 1] == ' ') {
            available_moves[move_count++] = current_index + 1;
        }
        // Check up
        if (current_row > 0 && grid_display[current_row - 1][current_col] == ' ') {
            available_moves[move_count++] = current_index - grid_size;
        }
        // Check down
        if (current_row < grid_size - 1 && grid_display[current_row + 1][current_col] == ' ') {
            available_moves[move_count++] = current_index + grid_size;
        }

        if (move_count == 0) {
            printf("\n\nYou are stuck! You lost.\n");
            break; // End the game
        }

        printf("Available moves: ");
        for (int i = 0; i < move_count; i++) {
            printf("%d ", available_moves[i]);
        }
        printf("\n");

        int next_index;
        printf("Enter the next index to move to (or 'Q' to save): ");
        char input[10];
        scanf_s("%9s", input, 10);
        while (getchar() != '\n'); // Clear input buffer

        if (input[0] == 'Q' || input[0] == 'q') {
            save_game(exit, monsters, hearts, surprise, current_heart, grid_size, current_index, used_indices, used_count, grid_display, errormove);
            char exit_ccontinue_input[10];
            printf("if you want to countinue playing enter 'Y' if you want to exit the game enter 'N'");
            scanf_s("%9s", exit_ccontinue_input, 10);
            while (getchar() != '\n'); // Clear input buffer
            if (exit_ccontinue_input[0] == 'Y' || exit_ccontinue_input[0] == 'y') {
                continue; // Go to the next iteration to allow further moves or saving
            }
            else if (exit_ccontinue_input[0] == 'N' || exit_ccontinue_input[0] == 'n') {
                printf("Thanks for playing!\n");
                break; // Exit the game
            }
            else {
                printf("Invalid input.Continuing the game anyway.\n");
                continue; // Go to the next iteration to allow further moves or saving
            }
        }

        input_check = sscanf_s(input, "%d", &next_index);

        if (input_check != 1) {
            printf("\n\nInvalid input. Please choose from the available moves or 'Q' to save.\n");
            errormove++;
            if (errormove == 4) {
                printf("\n\nyou have 1 more try to enter correct index before the game endes\n");
            }
            if (errormove == 5) {
                printf("\n\n\nyou are not good at this game, try again next time \n");
                break;
            }
            continue; // Skip the rest of the loop and ask for input again
        }

        // Validate the move
        int valid_move = 0;
        for (int i = 0; i < move_count; i++) {
            if (available_moves[i] == next_index) {
                valid_move = 1;
                break;
            }
        }

        if (valid_move) {
            // Mark the previous position with 'x'
            grid_display[current_row][current_col] = 'x';

            // Update the current position
            current_index = next_index;
            current_row = (current_index - 1) / grid_size;
            current_col = (current_index - 1) % grid_size;
            grid_display[current_row][current_col] = 'o';

            //check if you went into a room with a surprise
            current_heart = check_surprise(current_index, surprise.locations, surprise.size, current_heart, exit);

            if (current_heart == 100) {
                SetConsoleTextAttribute(color, 0x0007 | 0x0056);//purple
                printf("the secret portal took you to the exit and you won the game!\n");
                SetConsoleTextAttribute(color, FOREGROUND_RED | FOREGROUND_GREEN | FOREGROUND_BLUE);
                break;
            }

            //-----------------from here its checks if the room has somthing........
            //check if you went into a room with a monster and takes a live from you and in case you have 0 lives gives a messege
            //that you died
            current_heart = check_monster(current_index, monsters.locations, monsters.size, current_heart);
            if (current_heart == 0) {
                SetConsoleTextAttribute(color, BACKGROUND_RED);
                printf("\n\nyou died and lost the game\n");
                SetConsoleTextAttribute(color, FOREGROUND_RED | FOREGROUND_GREEN | FOREGROUND_BLUE);
                break;
            }

            // checks if you found the exit
            result = check_exit(current_index, exit);
            if (result == 1) {
                break;
            }

            // checks if you found a heart
            current_heart = check_heart(current_index, hearts.locations, hearts.size, current_heart);

            // -------------------.....or if its empty

            // Add the index to used indices
            used_indices.used_locations[used_count++] = next_index;
            errormove = 0; // Reset error move counter on a valid move
        }
        else {
            printf("\n\nInvalid move. Please choose from the available moves.\n");
            errormove++;
            if (errormove == 4) {
                printf("\n\nyou have 1 more try to enter correct index before the game endes\n");
            }
            if (errormove == 5) {
                printf("\n\n\nyou are not good at this game, try again next time \n");
                break;
            }
        }
    }
}

void check_if_double(int arr[], int size, int grid_max) {
    for (int i = 0; i < size; i++) {
        for (int j = 0; j < size; j++) {
            if (i != j && arr[i] == arr[j]) {
                //i!=j is for the computer to not thinks there are doublr
                arr[i] = arr[i] + 6;
                if (arr[i] >= grid_max) {
                    arr[i] = (arr[i] % grid_max) + 1;
                }
                j = -1;//to check again if there are any more double
            }
            else if (arr[i] == 0) {
                arr[i]++;
            }
        }
    }
}

// check if there are double with ((monster or heart or surprise) and exit)
void check_double_with_exit(int arr[], int size, int exit, int grid_max) {
    for (int i = 0; i < size; i++) {
        if (arr[i] == exit) {
            arr[i] = arr[i] + 3;
            if (arr[i] >= grid_max) {
                arr[i] = (arr[i] % grid_max) + 1;
            }
        }
        else if (arr[i] == 0) {
            arr[i]++;
        }
    }
}

// check if there are doubles with monster and heart
void check_monster_heart_double(int arr_monster[], int monster_size, int arr_heart[], int heart_size, int grid_max) {
    for (int i = 0; i < monster_size; i++) {
        for (int j = 0; j < heart_size; j++) {
            while (arr_monster[i] == arr_heart[j]) {
                arr_monster[i] = arr_monster[i] + 9;
                if (arr_monster[i] >= grid_max) {
                    arr_monster[i] = (arr_monster[i] % grid_max) + 1;
                }
                j = -1;//to check again if there are any more double
            }
            if (arr_monster[i] == 0) {
                arr_monster[i]++;
            }
        }
    }
}

// check if there are doubles with surprise and monster or heart
void check_surprise_diffrent_double(int arr_surprise[], int surprise_size, int arr_diffrent[], int diffrent_size, int grid_max) {
    for (int i = 0; i < surprise_size; i++) {
        for (int j = 0; j < diffrent_size; j++) {
            while (arr_surprise[i] == arr_diffrent[j]) {
                arr_surprise[i] = arr_surprise[i] + 2;
                if (arr_surprise[i] > MAX_INDEX) {
                    arr_surprise[i] = (arr_surprise[i] - 1) % MAX_INDEX + 1;
                }
                j = -1;//to check again if there are any more double
            }
            if (arr_surprise[i] == grid_max) {
                arr_surprise[i] = arr_surprise[i] % 10;
            }
            else if (arr_surprise[i] == 0) {
                arr_surprise[i]++;
            }
        }
    }
}

// 'random' calc where will be the exit
int exit_calc(int grid_max) {
    int exit = 0;
    exit = (rand() % grid_max);
    if (exit == 0) {
        exit++;
    }
    else if (exit == grid_max) {
        exit = exit % 10;
    }
    return exit;
}

//check if the player found the exit
int check_exit(int location, int exit) {
    int result = 0;
    HANDLE  color = GetStdHandle(STD_OUTPUT_HANDLE);
    if (location == exit) {
        SetConsoleTextAttribute(color, 0x0006); //yellow
        printf("\n\n\nyou found the exit and you won the game!\n Good job!\n");
        SetConsoleTextAttribute(color, FOREGROUND_RED | FOREGROUND_GREEN | FOREGROUND_BLUE);
        result = 1;
    }
    return result;
}

