    }
    return exit;
}

//puts hearts into 'random' rooms
void put_heart(int arr_heart[], int size, int grid_max) {
    for (int i = 0; i < size; i++) {
        arr_heart[i] = (rand() % (grid_max - 1) + 1);
    }
}

//checks if you in a room with a monster
int check_monster(int location, int arr_monster[], int monster_size, int current_heart) {
    HANDLE  color = GetStdHandle(STD_OUTPUT_HANDLE);
    for (int i = 0; i < monster_size; i++) {
        if (location == arr_monster[i]) {
            current_heart = remove_heart(current_heart);
            SetConsoleTextAttribute(color, FOREGROUND_RED);
            printf("You walked into a room with a monster and lost a heart\n");
            printf("Your current amount of hearts is %d \n", current_heart);
            SetConsoleTextAttribute(color, FOREGROUND_RED | FOREGROUND_GREEN | FOREGROUND_BLUE);
        }
    }
    return current_heart;
}

//check if the player entered a room with an heart
int check_heart(int location, int arr_heart[], int heart_size, int current_heart) {
    HANDLE  color = GetStdHandle(STD_OUTPUT_HANDLE);
    for (int i = 0; i < heart_size; i++) {
        if (location == arr_heart[i]) {
            current_heart = add_heart(current_heart);
            SetConsoleTextAttribute(color, FOREGROUND_BLUE);
            printf("You walked into a room with a heart and you just gained a heart!\n");
            printf("Your current amount of hearts is %d \n", current_heart);
            SetConsoleTextAttribute(color, FOREGROUND_RED | FOREGROUND_GREEN | FOREGROUND_BLUE);
        }
    }
    return current_heart;
}

//remove hearts to player
int remove_heart(int current_heart) {
    current_heart--;
    return current_heart;
}

//add hearts to player
int add_heart(int current_heart) {
    current_heart++;
    return current_heart;
}

