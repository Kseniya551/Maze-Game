            printf("\n\nyou walked into a room with a surprise! \n the surprise is:\n");
            switch (i) {
            case 0:
                SetConsoleTextAttribute(color, FOREGROUND_RED);
                printf("\n\nyou fell into a pit and lost a heart! \n");
                current_heart = remove_heart(current_heart);
                SetConsoleTextAttribute(color, FOREGROUND_RED | FOREGROUND_GREEN | FOREGROUND_BLUE);
                break;
            case 1:
                SetConsoleTextAttribute(color, FOREGROUND_BLUE);
                printf("\n\nyou found a magic potion and got an heart!\n");
                current_heart = add_heart(current_heart);
                SetConsoleTextAttribute(color, FOREGROUND_RED | FOREGROUND_GREEN | FOREGROUND_BLUE);
                break;
            case 2:
                SetConsoleTextAttribute(color, FOREGROUND_GREEN);
                printf("\n\nyou found a map!\n");
                printf("you got a clue where the exit is!\n");
                if (exit >= 1 && exit <= 6) {
                    printf("the exit in the first line of rooms! \n");
                }
                else if (exit >= 7 && exit <= 12) {
                    printf("the exit in the second line of rooms! \n");
                }
                else if (exit >= 13 && exit <= 18) {
                    printf("the exit in the third line of rooms! \n");
                }
                else if (exit >= 19 && exit <= 24) {
                    printf("the exit in the fourth line of rooms! \n");
                }
                else if (exit >= 25 && exit <= 30) {
                    printf("the exit in the fifth line of rooms! \n");
                }
                else if (exit >= 31 && exit <= 36) {
                    printf("the exit in the sixth line of rooms! \n");
                }
                SetConsoleTextAttribute(color, FOREGROUND_RED | FOREGROUND_GREEN | FOREGROUND_BLUE);
                break;
            case 3:
                SetConsoleTextAttribute(color, FOREGROUND_BLUE);
                printf("\n\nyou found a shield and because of that you got a heart!\n");
                current_heart = add_heart(current_heart);
                SetConsoleTextAttribute(color, FOREGROUND_RED | FOREGROUND_GREEN | FOREGROUND_BLUE);
                break;
            case 4:
                SetConsoleTextAttribute(color, FOREGROUND_RED);
                printf("\n\nyou found a room with a sleeping monsters and you just woke him up!\n you lost a heart!\n");
                current_heart = remove_heart(current_heart);
                SetConsoleTextAttribute(color, FOREGROUND_RED | FOREGROUND_GREEN | FOREGROUND_BLUE);
                break;
            case 5:
                SetConsoleTextAttribute(color, 0x0007 | 0x0056); //purple
                printf("\n\nyou found a secret portal!\n");
                current_heart = 100;
                SetConsoleTextAttribute(color, FOREGROUND_RED | FOREGROUND_GREEN | FOREGROUND_BLUE);
                break;
            }
        }
    }
    return current_heart;
}

