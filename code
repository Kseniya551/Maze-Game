            }
        }
        else {
            printf("Invalid input. Using Medium as default.\n");
            grid_size = GRID_SIZE_MEDIUM;
            monster_size = MONSTER_SIZE_MEDIUM;
            heart_size = HEART_SIZE_MEDIUM;
            start_index = START_INDEX_MEDIUM;
            surprise_size = 0;
            while (getchar() != '\n');
        }
        used_indices.size = MAX_INDEX;
        monsters.size = monster_size;
        hearts.size = heart_size;
        surprise.size = surprise_size;


        int grid_max = grid_size * grid_size;
        used_indices.used_locations[0] = 0;
        monsters.locations[0] = 0;
        hearts.locations[0] = 0;
        surprise.locations[0] = 0;

        //calc the 'random' position for the game
        exit_result = exit_calc(grid_max);
        put_monster(monsters.locations, monsters.size, grid_max);
        put_heart(hearts.locations, hearts.size, grid_max);
        put_surprise(surprise.locations, surprise.size, grid_max);
        //===============

        //to self info-----------------------------------------------------------
        for_self_info(exit_result, monsters, hearts, surprise);
        //-------------------------------------------------------

        //check if there are any doubles------------------------------------
        for (int i = 0; i < 5; i++) {
            exit_result = check_exit_if_zero(exit_result);
            check_double_with_exit(monsters.locations, monsters.size, exit_result, grid_max);
            check_double_with_exit(hearts.locations, hearts.size, exit_result, grid_max);
            check_double_with_exit(surprise.locations, surprise.size, exit_result, grid_max);
            check_monster_heart_double(monsters.locations, monsters.size, hearts.locations, hearts.size, grid_max);
            check_surprise_diffrent_double(surprise.locations, surprise.size, monsters.locations, monsters.size, grid_max);
            check_surprise_diffrent_double(surprise.locations, surprise.size, hearts.locations, hearts.size, grid_max);
            check_if_double(surprise.locations, surprise.size, grid_max);
            check_if_double(monsters.locations, monsters.size, grid_max);
            check_if_double(hearts.locations, hearts.size, grid_max);
        }
        //------------------------------------------------------------------------

        //for self info------------------------------------------------------
        for_self_info(exit_result, monsters, hearts, surprise);
        //----------------------------------------------------
    }
    else {
        // If game loaded, no need to set up new game parameters
    }

    //the games begin after all the calc and after getting the difficulty level (or loading)
    game(exit_result, monsters, hearts, current_heart, grid_size, start_index, surprise, used_indices, load_flag);
    return 0;
}

